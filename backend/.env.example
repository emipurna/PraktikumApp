PORT=8080

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=your_database_name
DB_SSLMODE=disable

# Admin Credentials (Ganti dengan kredensial Anda di file .env lokal)
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_admin_password

# URL Frontend Production (Contoh: https://praktikum-app.vercel.app)
FRONTEND_URL=http://localhost:5173
